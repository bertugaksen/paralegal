{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/downloads/Paralegal_Setup.exe",
      "destination": "https://github.com/bertugaksen/paralegal/releases/download/v1.0.0/Paralegal_Setup.exe",
      "permanent": false
    },
    {
      "source": "/downloads/:path*",
      "destination": "https://github.com/bertugaksen/paralegal/releases/download/v1.0.0/Paralegal_Setup.exe",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/Paralegal_Setup.exe",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Paralegal_Setup.exe\""
        },
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
